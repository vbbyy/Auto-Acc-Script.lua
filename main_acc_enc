local _H = ""
local _K = {217,159,128,151,54,95,132,245}
local _KL = #_K

local _C = string.char
local _bxor = (bit32 and bit32.bxor) or (bit and bit.bxor)
if not _bxor then
    local _ok, _fn = pcall(load, "return function(a, b) return a ~ b end")
    if _ok and type(_fn) == "function" then
        _bxor = _fn()
    end
end
if not _bxor then
    _bxor = function(a, b)
        local c, p = 0, 1
        while a > 0 or b > 0 do
            local ra, rb = a % 2, b % 2
            if ra ~= rb then c = c + p end
            a, b, p = (a - ra) / 2, (b - rb) / 2, p * 2
        end
        return c
    end
end

local _buf = {}
local _idx = 1
for i = 1, #_H, 2 do
    local b = tonumber(_H:sub(i, i + 1), 16)
    local k = _K[(_idx - 1) % _KL + 1]
    _buf[_idx] = _C(_bxor(b, k))
    _idx = _idx + 1
end

local _code = table.concat(_buf)
local _fn, _err = (loadstring or load)(_code, "@payload", "bt")
if not _fn then
    error("[EncError] Gagal memuat payload bytecode: " .. tostring(_err))
end

return _fn()
